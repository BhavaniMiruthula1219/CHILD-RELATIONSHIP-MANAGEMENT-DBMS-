from flask import Flask, request, render_template
import sqlite3
from datetime import datetime
import os

app = Flask(_name_)

# Database initialization
def init_db():
    if not os.path.exists('crm.db'):
        conn = sqlite3.connect('crm.db')
        c = conn.cursor()
        c.execute('''CREATE TABLE IF NOT EXISTS users (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        name TEXT NOT NULL,
                        email TEXT NOT NULL UNIQUE
                     )''')
        c.execute('''CREATE TABLE IF NOT EXISTS queries (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        user_id INTEGER,
                        query_text TEXT NOT NULL,
                        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
                        FOREIGN KEY (user_id) REFERENCES users (id)
                     )''')
        conn.commit()
        conn.close()

# Home route to display form and responses
@app.route('/', methods=['GET', 'POST'])
def index():
    response = None
    query_history = []
    
    if request.method == 'POST':
        name = request.form['name']
        email = request.form['email']
        query = request.form['query']
        
        conn = sqlite3.connect('crm.db')
        c = conn.cursor()
        
        # Check if user exists, if not, create new user
        c.execute("SELECT id FROM users WHERE email = ?", (email,))
        user = c.fetchone()
        if user:
            user_id = user[0]
        else:
            c.execute("INSERT INTO users (name, email) VALUES (?, ?)", (name, email))
            user_id = c.lastrowid
        
        # Insert query
        c.execute("INSERT INTO queries (user_id, query_text) VALUES (?, ?)", (user_id, query))
        
        # Retrieve query history
        c.execute("SELECT query_text, timestamp FROM queries WHERE user_id = ? ORDER BY timestamp DESC", (user_id,))
        query_history = c.fetchall()
        
        # Generate response based on history
        if query_history:
            response = f"Thank you, {name}, for your query: '{query}'. "
            if len(query_history) > 1:
                response += f"We noticed you previously asked: '{query_history[1][0]}' on {query_history[1][1]}. "
            response += "Our team will address your query soon."
        else:
            response = f"Thank you, {name}, for your first query: '{query}'. Our team will respond shortly."
        
        conn.commit()
        conn.close()
    
    return render_template('index.html', response=response, query_history=query_history)

if _name_ == '_main_':
    init_db()
    app.run(debug=True)
